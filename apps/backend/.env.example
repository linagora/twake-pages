RABBITMQ_URL=amqp://guest:guest@localhost:5674
# Exchange and queue names, when the broker's differ from these defaults
# RABBITMQ_SPACE_EXCHANGE=space
# RABBITMQ_B2B_EXCHANGE=b2b
# RABBITMQ_AUTH_EXCHANGE=auth
# RABBITMQ_SETTINGS_EXCHANGE=settings
# RABBITMQ_ACTIVITY_EXCHANGE=activity
# RABBITMQ_QUEUE=platform.all.twake-pages
# RABBITMQ_DEAD_LETTER_EXCHANGE=twake-pages.dlx
DATABASE_URL=postgres://twake_pages:twake_pages@localhost:5434/twake_pages
HTTP_PORT=8090
APP_URL=http://localhost:3400
LOG_LEVEL=info
OIDC_ISSUER=https://sign-up.twake.app/
OIDC_CLIENT_SECRET=
# Follows the TwakeSpace spaces through their RabbitMQ events
# SPACE_INTEGRATION=true
# Origins of the Grist instances whose documents pages may embed, space separated
# GRIST_ORIGINS=https://grist.example.com
# Emails are sent only when this is set, e.g. to a local mailpit.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Twake Pages <pages@twake.app>
