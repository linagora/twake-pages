{
  "name": "@twake-pages/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@linagora/rabbitmq-client": "^0.6.0",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.12.5",
    "fractional-indexing": "^4.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.15",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@types/nodemailer": "^8.0.2",
    "amqplib": "^2.2.0",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
